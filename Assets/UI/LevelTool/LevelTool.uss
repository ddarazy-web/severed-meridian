.level-tool {
    flex-grow: 1;
    background-color: rgb(18, 24, 33);
    color: rgb(224, 232, 241);
    padding: 6px;
    font-size: 14px;
}
.toolbar { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; align-items: center; margin-top: 2px; margin-bottom: 4px; }
.body { flex-direction: row; flex-grow: 1; min-height: 0; }
.sidebar { width: 210px; flex-shrink: 0; padding: 8px; background-color: rgb(27, 35, 47); border-width: 1px; border-color: rgb(47, 60, 76); border-radius: 8px; -unity-background-image-tint-color: rgba(255, 255, 255, 0.06); }
.board { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin: 16px; }
.cell { flex-shrink: 0; border-width: 1px; border-color: rgb(49, 65, 81); border-radius: 3px; background-color: rgb(38, 53, 68); -unity-text-align: middle-center; overflow: hidden; font-size: 10px; }
.cell.inactive { background-color: rgb(20, 28, 38); color: rgb(100, 117, 134); border-color: rgb(33, 45, 58); }
.selected { border-width: 2px; border-color: rgb(116, 224, 206); }
Button { min-height: 32px; padding: 5px 10px; margin: 2px; color: rgb(218, 228, 239); background-color: rgb(36, 48, 63); border-width: 1px; border-color: rgb(58, 75, 93); border-radius: 6px; -unity-text-align: middle-center; transition-property: background-color, border-color; transition-duration: 0.1s; }
Button:hover { background-color: rgb(47, 65, 82); border-color: rgb(83, 111, 131); }
Button:active { background-color: rgb(28, 43, 57); }
Button.selected { background-color: rgb(31, 66, 68); border-width: 1px; border-color: rgb(83, 179, 166); color: rgb(184, 244, 227); }
Button:disabled { opacity: 0.4; }
Label { white-space: normal; }
.status { padding: 8px; min-height: 40px; flex-shrink: 0; color: rgb(158, 220, 211); }
.unity-base-field { flex-shrink: 0; margin: 4px 3px; min-height: 30px; }
.unity-base-field__label { min-width: 88px; color: rgb(168, 186, 202); }
.level-tool .unity-base-field__input { background-color: rgb(18, 27, 38); color: rgb(234, 241, 248); padding: 5px 7px; min-height: 26px; border-width: 1px; border-color: rgb(52, 69, 87); border-radius: 5px; -unity-background-image-tint-color: rgba(255, 255, 255, 0.08); }
.unity-base-field__input:focus { border-color: rgb(95, 194, 177); }
.level-tool .unity-toggle__input { background-color: transparent; border-width: 0; padding: 0; }
.level-tool .unity-toggle__checkmark { width: 18px; height: 18px; border-width: 1px; border-color: rgb(108, 136, 155); border-radius: 4px; background-color: rgb(18, 27, 38); }
.level-tool Image { background-color: transparent; }
.unity-toggle__input:checked > .unity-toggle__checkmark { background-color: rgb(81, 189, 162); }
.modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.7); }
.dialog { width: 620px; max-width: 95%; max-height: 95%; padding: 20px; background-color: rgb(27, 37, 50); border-width: 1px; border-color: rgb(72, 99, 119); border-radius: 12px; -unity-background-image-tint-color: rgba(255, 255, 255, 0.08); }
.unity-scroll-view { min-height: 0; }
.unity-scroll-view__content-viewport { overflow: hidden; min-height: 0; flex-grow: 1; }
.unity-scroll-view__content-container { flex-shrink: 0; }
.unity-scroller--vertical { width: 14px; }
.unity-scroller--horizontal { height: 14px; }
.unity-base-slider__tracker { background-color: rgb(15, 23, 33); min-height: 5px; min-width: 5px; }
.level-tool .unity-base-slider__dragger { background-color: rgb(76, 106, 126); min-height: 12px; min-width: 12px; border-radius: 4px; }
.unity-base-slider { min-height: 18px; }
.editor-shell { flex-grow: 1; min-height: 0; }
.menu-bar { flex-direction: row; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: rgb(40, 54, 69); padding-bottom: 4px; }
.menu-bar > Button { background-color: transparent; border-width: 0; min-width: 60px; }
.tool-header { flex-direction: row; align-items: center; flex-shrink: 0; padding: 3px 4px; }
.workspace-identity { flex-grow: 1; min-width: 0; margin-right: 10px; }
.level-title { font-size: 18px; -unity-font-style: bold; margin-bottom: 0; }
#workspace-status { font-size: 11px; color: rgb(163, 185, 198); max-height: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.save-status-row { flex-direction: row; align-items: center; }
.save-status-row #workspace-status { flex-grow: 1; min-width: 0; }
#save-status-details { flex-shrink: 0; min-width: 76px; min-height: 26px; padding: 2px 8px; margin: 0 0 0 6px; font-size: 11px; }
.mobile-level-tool #save-status-details { min-height: 44px; min-width: 88px; font-size: 12px; }
.workspace-tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 2px; border-bottom-width: 1px; border-bottom-color: rgb(42, 57, 72); }
.workspace-tabs > Button { flex-grow: 1; min-height: 30px; background-color: transparent; border-width: 0; border-bottom-width: 2px; border-bottom-color: transparent; border-radius: 4px; color: rgb(153, 176, 194); }
.workspace-tabs > Button:hover { background-color: rgb(29, 43, 57); color: rgb(230, 239, 246); }
.workspace-tabs > .selected { background-color: rgb(26, 49, 56); border-width: 0; border-bottom-width: 2px; border-bottom-color: rgb(105, 212, 187); color: rgb(179, 244, 225); }
.page-tools { flex-direction: row; flex-shrink: 0; min-height: 32px; align-items: center; }
.panel-tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 6px; }
.panel-tabs > Button { flex-grow: 1; min-width: 0; font-size: 12px; }
.panel-content { flex-grow: 1; min-height: 0; }
#left-panel { width: 205px; margin-right: 6px; }
#right-panel { width: 290px; margin-left: 6px; }
.board-viewport { flex-grow: 1; min-width: 160px; background-color: rgb(14, 21, 30); border-width: 1px; border-color: rgb(39, 54, 70); border-radius: 8px; }
.board-viewport > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { align-items: center; }
.validation-panel { flex-shrink: 0; max-height: 160px; margin-top: 5px; padding: 4px; background-color: rgb(25, 36, 48); border-radius: 6px; }
.status { min-height: 30px; padding: 5px 8px; font-size: 12px; }
#trial-input-bar { padding: 2px 6px; margin-top: 2px; margin-bottom: 6px; background-color: rgb(23, 33, 45); border-radius: 6px; }
#trial-pack-status { font-size: 11px; color: rgb(145, 167, 185); flex-grow: 1; flex-shrink: 1; margin: 4px 8px; }
#save { background-color: rgb(35, 73, 67); border-color: rgb(65, 133, 116); color: rgb(197, 248, 223); }
#play { background-color: rgb(49, 120, 106); border-color: rgb(102, 201, 169); color: rgb(240, 255, 247); -unity-font-style: bold; }
#play:hover { background-color: rgb(63, 145, 125); }
Button:focus { border-color: rgb(169, 245, 228); }
.command-menu-item { flex-direction: row; justify-content: space-between; min-height: 34px; }
.command-gesture { margin-left: 20px; color: rgb(156, 190, 199); -unity-text-align: middle-right; }
.shortcut-entry { margin: 4px 0; padding: 8px; background-color: rgb(26, 36, 47); }
#trial-source { flex-direction: row; align-items: center; }
#trial-source > .unity-base-field__input { min-width: 180px; }
.unity-scroller__low-button, .unity-scroller__high-button { min-height: 0; min-width: 0; padding: 0; margin: 0; border-width: 0; }
.unity-scroller--vertical > .unity-scroller__low-button, .unity-scroller--vertical > .unity-scroller__high-button { height: 10px; }
.unity-scroller--horizontal > .unity-scroller__low-button, .unity-scroller--horizontal > .unity-scroller__high-button { width: 10px; }
.unity-scroller--horizontal { flex-direction: row; height: 14px; min-height: 14px; max-height: 14px; }
.unity-scroller--vertical { flex-direction: column; width: 14px; min-width: 14px; max-width: 14px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-scroller > .unity-base-slider { flex-grow: 1; min-width: 0; min-height: 0; margin: 0; padding: 0; }
.unity-base-slider__drag-container { flex-grow: 1; position: relative; }
.unity-base-slider__dragger { position: absolute; }
.unity-slider--horizontal .unity-base-slider__dragger { width: 12px; height: 12px; }
.unity-foldout__toggle, .unity-toggle__input { flex-direction: row; align-items: center; }
.unity-toggle__text { margin-left: 6px; }
.unity-base-field__input { overflow: hidden; }
.level-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.skin-button { -unity-background-image-tint-color: rgba(255, 255, 255, 0.08); }
.skin-button:hover { -unity-background-image-tint-color: rgba(255, 255, 255, 0.12); }
.skin-button:active { -unity-background-image-tint-color: rgba(255, 255, 255, 0.04); }
.skin-button.selected, .skin-button:focus { border-color: rgb(105, 212, 187); }
#levels Button, #palette Button { -unity-text-align: middle-left; padding-left: 12px; min-height: 34px; margin-bottom: 4px; }
.unity-foldout__toggle { margin-top: 8px; padding-bottom: 4px; color: rgb(181, 205, 221); }
#board-touch-tools { height: 40px; margin-bottom: 6px; background-color: rgb(23, 33, 45); border-radius: 6px; }
#board-touch-tools .unity-toggle { min-height: 30px; }
#board-touch-hint { align-self: center; margin-left: 10px; font-size: 11px; color: rgb(137, 162, 181); }

/* 160 DPI 기준 패널 배율에서 48 UI 단위 누름 영역을 목표로 한다. 실제 dp는 기기 검수가 필요하다. */
.mobile-level-tool Button { min-height: 48px; }
.mobile-level-tool #board-touch-tools { height: 56px; }
.mobile-level-tool #board-touch-tools .unity-toggle { min-height: 48px; }
.mobile-level-tool #trial-input-bar { flex-direction: column; align-items: stretch; }
.mobile-level-tool #trial-pack-status { flex-grow: 0; max-height: 32px; overflow: hidden; }
.mobile-level-tool #levels Button, .mobile-level-tool #palette Button { min-height: 48px; }
.mobile-level-tool .unity-base-field { min-height: 48px; }
.mobile-level-tool .unity-base-field__input { min-height: 40px; }
.mobile-level-tool .unity-base-dropdown__item { min-height: 48px; }
.mobile-level-tool .unity-scroller > .unity-base-slider { min-height: 0; }
.mobile-level-tool .unity-scroller .unity-base-field__input { min-height: 0; padding: 0; }
.mobile-level-tool .tool-header { flex-direction: column; align-items: stretch; padding: 0; }
.mobile-level-tool .workspace-identity { margin-right: 0; }
.mobile-level-tool .level-title { font-size: 16px; margin-bottom: 0; }
.mobile-level-tool #workspace-status { max-height: 16px; white-space: nowrap; text-overflow: ellipsis; }
.mobile-level-tool .toolbar { flex-wrap: nowrap; margin-top: 2px; margin-bottom: 2px; }
.mobile-level-tool .toolbar > Button { flex-grow: 1; flex-shrink: 1; min-width: 0; padding-left: 4px; padding-right: 4px; }
.mobile-level-tool .board-viewport { min-width: 0; }
.mobile-level-tool .sidebar { padding: 4px; }
.mobile-level-tool #levels, .mobile-level-tool #palette { min-height: 120px; }
.mobile-level-tool .status { min-height: 22px; max-height: 36px; padding: 2px 4px; overflow: hidden; }
.mobile-level-tool .validation-panel { max-height: 64px; }
.mobile-navigation { flex-direction: row; flex-shrink: 0; }
.mobile-navigation > Button { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mobile-tool-status { font-size: 12px; min-height: 20px; flex-shrink: 0; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
#mobile-more-panel .menu-bar, #mobile-more-panel .workspace-tabs, #mobile-more-panel .page-tools { flex-direction: column; align-items: stretch; }
#mobile-more-panel .workspace-tabs > Button { flex-grow: 0; }
.mobile-level-tool #trial-source { flex-direction: column; align-items: stretch; }
.mobile-level-tool .mobile-trial-controls { flex-direction: column; align-items: stretch; }
.mobile-landscape .workspace-identity { display: none; }
.mobile-landscape .status { max-height: 22px; }
.mobile-landscape .validation-panel { max-height: 48px; }
.cell.touch-preview {
    border-left-color: rgb(99, 216, 204);
    border-right-color: rgb(99, 216, 204);
    border-top-color: rgb(99, 216, 204);
    border-bottom-color: rgb(99, 216, 204);
}
#board-touch-tools Toggle { flex-direction: row; align-items: center; }
#board-touch-tools Toggle > .unity-base-field__label { min-width: 0; margin-right: 6px; white-space: nowrap; }
#board-touch-tools Toggle > .unity-base-field__input { min-height: 0; }

/* 편집 보드를 우선 확보하고 시험 입력은 보조 탭과 같은 줄에 둔다. */
.workspace-context { flex-direction: row; flex-shrink: 0; align-items: center; }
.workspace-context .page-tools { margin-right: 10px; }
.workspace-context #trial-input-bar { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-bottom: 2px; flex-wrap: nowrap; }
.workspace-context #trial-pack-status { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.menu-bar > Button { min-height: 26px; padding-top: 2px; padding-bottom: 2px; }
.sidebar { min-height: 0; overflow: hidden; }
#levels Button, #palette Button, #properties Button, #properties Label { flex-shrink: 0; }
#levels, #palette, #properties { flex-basis: 0; }
.level-tool .unity-scroller .unity-base-field__input {
    min-width: 0; min-height: 0; padding: 0; margin: 0; border-width: 0;
    background-color: transparent;
}
.level-tool .unity-scroller .unity-base-slider__tracker { position: absolute; }
.level-tool .unity-scroller--vertical .unity-base-slider__tracker { top: 0; bottom: 0; left: 4px; right: 4px; }
.level-tool .unity-scroller--horizontal .unity-base-slider__tracker { top: 4px; bottom: 4px; left: 0; right: 0; }
.level-tool .unity-scroller--vertical .unity-base-slider__dragger { width: 12px; }
.level-tool .unity-scroller--horizontal .unity-base-slider__dragger { height: 12px; }
.mobile-level-tool .workspace-context { display: none; }
.mobile-level-tool .menu-bar > Button { min-height: 48px; }
.board-focus .tool-header, .board-focus .workspace-tabs, .board-focus .workspace-context { display: none; }
.mobile-level-tool.board-focus .tool-header { display: flex; }
.level-tool .unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0;
}
.level-tool .unity-scroller--vertical { flex-shrink: 0; }
.level-tool .unity-scroller--horizontal { flex-shrink: 0; }
