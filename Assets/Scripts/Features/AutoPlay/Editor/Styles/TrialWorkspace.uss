.trial-workspace { padding: 8px 6px 4px 6px; color: #dce4ef; }
.trial-intro { color: #9eafc2; font-size: 11px; margin-bottom: 10px; flex-shrink: 0; }
.trial-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.trial-card { background-color: #29313e; border-width: 1px; border-color: #3b4859; border-radius: 8px; padding: 12px; min-height: 0; }
.trial-setup { width: 350px; flex-shrink: 0; margin-right: 12px; }
.trial-review { flex-grow: 1; min-width: 0; }
.trial-card-title { font-size: 16px; -unity-font-style: bold; color: #eaf1f9; margin: 0 0 12px 0; flex-shrink: 0; }
.trial-section-title { color: #bed0e2; -unity-font-style: bold; margin: 5px 0 7px 0; flex-shrink: 0; }
.trial-section-row { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.trial-divider { border-top-width: 1px; border-top-color: #425064; padding-top: 12px; margin-top: 12px; }
.trial-muted { color: #99a9bc; font-size: 11px; margin: 0 0 7px 0; white-space: normal; flex-shrink: 0; }
.trial-list { background-color: #202732; border-width: 1px; border-color: #3d4c60; border-radius: 5px; }
.trial-list .unity-collection-view__item { border-bottom-width: 1px; border-bottom-color: #303b4b; }
.trial-list .unity-collection-view__item--selected { background-color: #315567; }
.trial-list .unity-label { padding: 5px 8px; }
.trial-workspace .unity-button, .trial-workspace .unity-toolbar-menu { min-height: 27px; background-color: #354356; color: #dce6f2; border-width: 1px; border-color: #485a70; border-radius: 4px; padding: 3px 7px; }
.trial-workspace .unity-button:hover, .trial-workspace .unity-toolbar-menu:hover { background-color: #41546c; }
.trial-workspace .unity-button:disabled { opacity: 0.42; }
.trial-workspace .unity-base-field { margin: 3px 0; min-height: 26px; flex-shrink: 0; }
.trial-workspace .unity-base-field__label { color: #b3c4d7; }
.trial-workspace .unity-base-field__input { background-color: #1d2530; border-width: 1px; border-color: #465970; border-radius: 4px; }
.trial-estimate { color: #a7bdce; white-space: normal; margin: 8px 0; flex-shrink: 0; }
.trial-workspace #multi-start { background-color: #71cebb; border-color: #71cebb; color: #142f2c; -unity-font-style: bold; min-height: 36px; margin: 4px 0; }
.trial-workspace #multi-start:hover { background-color: #96e0d1; }
.trial-run-controls { flex-direction: row; flex-shrink: 0; }
.trial-run-controls .unity-button { flex-grow: 1; margin: 2px 0; }
.trial-run-controls #multi-stop { margin-left: 6px; }
.trial-progress { background-color: #213e48; color: #afdaca; border-radius: 4px; padding: 7px 9px; margin: 3px 0 7px 0; white-space: normal; flex-shrink: 0; }
.trial-result-tools { margin: 7px 0; flex-shrink: 0; }
.trial-result-tools .unity-button { margin-left: 0; margin-right: 6px; }
.trial-details { background-color: #202732; border-radius: 5px; padding: 10px; }
.trial-details .unity-label { color: #d9e6f2; font-size: 12px; }
.trial-workspace #record-management { margin-top: 10px; padding: 8px; border-radius: 5px; }
.trial-workspace #records-delete-all { color: #f0b7ad; background-color: #49343a; border-color: #80545a; }
.trial-analysis-tools { background-color: #29313e; padding: 8px; border-radius: 6px; margin-bottom: 8px; flex-shrink: 0; }
.trial-workspace #analysis-history { margin-right: 12px; background-color: #202732; border-radius: 6px; border-width: 1px; border-color: #3d4c60; }
.trial-workspace #analysis-statistics, .trial-workspace #analysis-comparison, .trial-workspace #analysis-cases-page { background-color: #29313e; border-radius: 6px; padding: 10px; }
