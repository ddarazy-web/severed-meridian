.initial-state .editor-title { flex-grow: 0; }
#initial-boundary { padding: 7px; background-color: #3a3529; color: #f4dba2; border-radius: 4px; flex-shrink: 0; }
.initial-toolbar { flex-direction: row; align-items: center; margin-top: 8px; flex-shrink: 0; }
.initial-toolbar .unity-base-field__label { min-width: 28px; width: 28px; }
#initial-level { flex-grow: 1; min-width: 150px; }
#initial-seed { width: 156px; }
#initial-diagnostics { max-height: 110px; flex-shrink: 0; }
#initial-status { margin: 8px 3px; }
.initial-body { flex-direction: row; flex-grow: 1; min-height: 0; }
#initial-board-scroll { flex-grow: 1; flex-basis: 0; background-color: #191e27; border-radius: 5px; }
#initial-grid { padding: 8px; width: 466px; flex-shrink: 0; }
.initial-row { flex-direction: row; flex-shrink: 0; }
.initial-state .initial-cell { width: 43px; height: 43px; flex-shrink: 0; margin: 1px; padding: 1px; font-size: 11px; }
.initial-state .initial-cell.inactive { background-color: #191e27; color: #657084; border-color: #262e3b; }
.initial-state .initial-cell.rabbit-0 { background-color: #693f53; }
.initial-state .initial-cell.rabbit-1 { background-color: #395b78; }
.initial-state .initial-cell.rabbit-2 { background-color: #586338; }
.initial-state .initial-cell.rabbit-3 { background-color: #715937; }
.initial-state .initial-cell.rabbit-4 { background-color: #624c79; }
.initial-state .initial-cell.covered { border-color: #bcb6cb; }
.initial-state .initial-cell.selected { border-width: 2px; border-color: #89daca; }
#initial-inspector { width: 225px; min-width: 225px; margin-left: 8px; padding: 9px; background-color: #2a313e; border-radius: 5px; }
#initial-details { color: #e0e5ef; margin-bottom: 20px; }
#initial-overview { color: #aebed0; }
#initial-mode { width: 260px; margin-top: 5px; flex-shrink: 0; }
#query-summary { color: #aebed0; margin-top: 4px; flex-shrink: 0; }
.initial-state .initial-cell.query-highlight { border-width: 2px; border-color: #f4dba2; }
#query-results .unity-button { font-size: 11px; margin-bottom: 4px; }
#query-results { max-height: 180px; }
#execution-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; margin-top: 4px; }
#execution-mode { margin-right: 12px; }
#execution-mode .unity-base-field__label { min-width: 60px; width: 60px; }
#execution-info { color: #aebed0; flex-shrink: 0; white-space: normal; margin: 4px; }
.initial-state .initial-cell.execution-input { border-width: 2px; border-color: #f4dba2; }
.initial-state .initial-cell.execution-created { border-width: 3px; border-color: #89daca; }
.initial-state .initial-cell.execution-removed { border-width: 2px; border-color: #d58292; }
#booster-toolbar .unity-toggle { flex-shrink: 0; margin-left: 10px; }
#booster-toolbar .unity-base-field__label { min-width: 0; width: auto; flex-shrink: 0; white-space: nowrap; }
#booster-status { color: #aebed0; white-space: normal; flex-shrink: 0; margin-top: 4px; }
#item-shuffle-confirmation { padding: 5px; background-color: #3a3529; }
#manual-toolbar, #manual-input { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-top: 5px; }
#manual-summary { white-space: normal; flex-shrink: 0; padding: 7px; color: #e0e5ef; }
#manual-diagnostics { flex-shrink: 0; margin-top: 4px; }
#manual-diagnostics .unity-scroll-view { max-height: 150px; }
.manual-play #initial-grid { align-self: center; }
.manual-play #initial-diagnostics { max-height: 65px; }
.manual-play .initial-toolbar { flex-wrap: wrap; }
#bot-trial { flex-shrink: 0; margin-top: 4px; }
#bot-buttons { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
#bot-buttons .unity-button { min-width: 70px; }
#bot-guide, #bot-progress, #bot-reason { white-space: normal; flex-shrink: 0; margin: 3px; }
#bot-reason { color: #aebed0; }
