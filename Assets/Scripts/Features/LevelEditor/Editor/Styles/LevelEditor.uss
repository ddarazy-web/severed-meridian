.match-editor {
    background-color: #20252f;
    color: #e0e5ef;
    padding: 8px;
}
#workspace-menubar {
    height: 28px;
    flex-shrink: 0;
    background-color: #1a2029;
    border-bottom-width: 1px;
    border-bottom-color: #3a485b;
    padding-left: 4px;
}
#workspace-menubar .unity-toolbar-menu {
    min-width: 58px;
    color: #d9e6f2;
    padding-left: 8px;
    padding-right: 8px;
}
#workspace-menubar .unity-toolbar-menu:hover { background-color: #35475c; }
#workspace-page-name { flex-grow: 1; -unity-text-align: middle-right; color: #87b7c2; margin-right: 10px; font-size: 11px; }
.editor-title {
    flex-grow: 1;
    color: #89daca;
    font-size: 15px;
    -unity-font-style: bold;
    margin: 2px 4px 8px 4px;
}
.editor-header { flex-direction: row; align-items: center; flex-shrink: 0; }
.editor-header .unity-toggle { margin: 0 8px 6px 8px; }
.editor-header .unity-base-field__label { min-width: 28px; }
.editor-toolbar .unity-toolbar-button {
    min-width: 52px;
    min-height: 26px;
    margin-left: 4px;
    border-radius: 4px;
    background-color: #364152;
    color: #e0e5ef;
}
.editor-toolbar .unity-toolbar-button:hover { background-color: #46566c; }
.editor-toolbar #level-asset { min-width: 110px; flex-shrink: 1; }
.match-editor .editor-toolbar {
    height: 34px;
    background-color: #2a313e;
    border-bottom-width: 0;
    padding: 3px;
    flex-shrink: 0;
}
.match-editor .unity-button {
    min-height: 26px;
    background-color: #364152;
    color: #e0e5ef;
    border-width: 1px;
    border-color: #475368;
    border-radius: 4px;
    padding: 3px 7px;
    white-space: normal;
}
.match-editor .unity-button:hover { background-color: #46566c; }
.match-editor .unity-button:active { background-color: #526980; }
.match-editor .unity-button:focus { border-color: #89daca; }
.match-editor .unity-button:disabled { opacity: 0.45; }
.match-editor #save-level, .match-editor #complete-flow {
    background-color: #78cbb7;
    border-color: #78cbb7;
    color: #152e2b;
    -unity-font-style: bold;
}
.match-editor #save-level:hover, .match-editor #complete-flow:hover { background-color: #9adfcc; }
.match-editor #asset-state {
    color: #a6b1c3;
    font-size: 10px;
    margin: 5px 4px 8px 4px;
    overflow: hidden;
    text-overflow: ellipsis;
}
.side-content { padding: 6px; }
#tool-scroll, #inspector-scroll { background-color: #2a313e; border-radius: 6px; }
.tab-bar { flex-direction: row; margin-bottom: 12px; flex-shrink: 0; }
.match-editor .tab { flex-grow: 1; flex-basis: 0; margin: 1px; padding-left: 2px; padding-right: 2px; }
.match-editor .tab.active { background-color: #496477; border-color: #89daca; color: #ffffff; }
.match-editor .unity-base-popup-field { margin-top: 4px; margin-bottom: 5px; min-height: 26px; }
.match-editor .unity-base-popup-field__input {
    min-height: 26px;
    background-color: #202733;
    color: #edf1f7;
    border-color: #526078;
    border-radius: 4px;
}
.match-editor .unity-base-field__label { min-width: 76px; color: #c8d2e1; }
.match-editor .unity-label { white-space: normal; }
.match-editor .unity-foldout { margin-top: 8px; }
#board-scroll { margin: 0 8px; background-color: #191e27; border-radius: 6px; }
.board-grid { margin: 12px 16px 20px 4px; }
#operation-status { padding: 8px; margin-top: 6px; color: #bce5dc; background-color: #293c40; border-radius: 4px; }
#validation-drawer { background-color: #2a313e; padding: 4px; flex-shrink: 0; }
#validation-status { color: #adbcd0; padding: 4px; }
#selected-cell-properties > .unity-label { margin-bottom: 8px; -unity-font-style: bold; }
#flow-heading { color: #a8bbd1; margin-bottom: 8px; }
#erase-layer, #delete-placement { color: #f1b0ab; }
#used-count { margin: 8px 0; color: #afc0d5; }
.match-editor .compact-menu {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 2px;
}
.match-editor .compact-menu > .unity-base-field__label {
    width: 58px;
    min-width: 58px;
    margin-right: 3px;
    padding-right: 0;
    flex-shrink: 0;
    white-space: nowrap;
}
.match-editor .compact-menu > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.match-editor .unity-base-popup-field__text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.match-editor #inspector-scroll .unity-base-field__label {
    white-space: nowrap;
    flex-shrink: 0;
}
.match-workspace {
    flex-grow: 1;
    background-color: rgb(35, 39, 48);
}
#workspace-header {
    height: 28px;
    flex-shrink: 0;
}
#workspace-header > Label {
    -unity-font-style: bold;
    margin-left: 8px;
    margin-right: 12px;
}
#workspace-tabs {
    flex-direction: row;
    flex-shrink: 0;
    padding: 3px 6px;
    background-color: rgb(29, 33, 42);
}
#workspace-tabs > Button {
    height: 26px;
    min-width: 110px;
    margin-right: 4px;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}
#workspace-tabs > .workspace-tab-active {
    background-color: rgb(51, 67, 86);
    color: rgb(237, 245, 255);
    border-bottom-color: rgb(116, 188, 234);
}
.workspace-panel {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}
.workspace-panel.initial-state > .editor-title {
    display: none;
}
.manual-help-row { flex-direction: row; align-items: center; flex-shrink: 1; min-width: 0; }
.manual-help-row > Label { flex-shrink: 1; min-width: 0; }
/* 도움말은 고정 자리를 갖고, 입력 영역이 남은 폭 안에서 줄어든다. */
.manual-help-field > .unity-base-field__input { min-width: 0; flex-shrink: 1; flex-grow: 1; }
.match-editor #inspector-scroll .manual-help-field > .unity-base-field__label {
    width: 110px;
    min-width: 76px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}
.manual-help-field { min-height: 22px; }
/* 목록 제목이 남은 폭을 모두 차지하면 오른쪽 항목 수 입력란과 도움말이 겹친다. */
.manual-help-field > .unity-toggle__text { flex-grow: 0; flex-shrink: 1; min-width: 0; }
.manual-help-icon, .match-editor .manual-help-icon {
    width: 20px;
    height: 20px;
    min-height: 20px;
    min-width: 20px;
    flex-shrink: 0;
    margin: 0 4px 0 2px;
    padding: 0;
    border-radius: 10px;
    background-color: rgb(56, 84, 85);
    color: rgb(196, 236, 224);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.manual-help-icon:hover, .match-editor .manual-help-icon:hover { background-color: rgb(70, 116, 110); }
#shape-recommendations {
    padding: 8px;
    background-color: rgb(40, 44, 49);
    border-bottom-width: 1px;
    border-bottom-color: rgb(76, 96, 94);
}
#shape-preview { margin-top: 6px; margin-bottom: 6px; }
